{
  "permissions": {
    "allow": [
      "Bash(npm install)",
      "Bash(npm run build)",
      "Bash(npm test)",
      "Bash(npm run check:fx)",
      "Bash(npm run render:*)",
      "Bash(node tests/seams.mjs)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-pixelfx.mjs\"",
            "statusMessage": "pixelfx/ reste intact"
          }
        ]
      }
    ]
  }
}
